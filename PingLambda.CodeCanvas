	"simulations": {
		"Deploy a Serverless API Endpoint on AWS Lambda": {
			"name": "Deploy a Serverless API Endpoint on AWS Lambda",
			"simSteps": [
				{
					"simStepId": "9ebf4db5-aabd-4d3e-b5e3-f72873bf00c0",
					"diagramNodeId": "e44c8697-6df5-468f-8412-f8d05e26bbb9",
					"simStepLabel": "Define Service Configuration",
					"simStepDescription": "The process starts with the Serverless Framework parsing the `serverless.yml` file. This file defines the service name ('basic-serverless-lambda'), the cloud provider (AWS), and the default configuration like runtime, stage, and region for all functions in the service.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "1",
						"endLine": "8",
						"relevantVariables": [
							"service",
							"provider",
							"name",
							"runtime",
							"stage",
							"region"
						]
					},
					"inputDataExample": "{}",
					"outputDataExample": "{\"service\": \"basic-serverless-lambda\", \"provider\": {\"name\": \"aws\", \"runtime\": \"nodejs18.x\", \"stage\": \"dev\", \"region\": \"us-west-1\"}}"
				},
				{
					"simStepId": "1d66d1da-06e4-4e9f-b9ef-be7c769c2187",
					"diagramNodeId": "55e29172-4e22-4b98-9e31-262ff35125fd",
					"simStepLabel": "Transmit Function Definition",
					"simStepDescription": "The framework reads the `functions` block from the configuration. This object, which maps the function name 'hello' to its code handler and specific properties like timeout and memory, is passed to the packaging and deployment module.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "10",
						"endLine": "14",
						"relevantVariables": [
							"functions",
							"hello",
							"handler",
							"timeout",
							"memorySize"
						]
					},
					"inputDataExample": "{\"functions\": {\"hello\": {\"handler\": \"src/handler.generateRandomNumber\", \"timeout\": 60, \"memorySize\": 128}}}",
					"outputDataExample": "{\"functions\": {\"hello\": {\"handler\": \"src/handler.generateRandomNumber\", \"timeout\": 60, \"memorySize\": 128}}}"
				},
				{
					"simStepId": "66396f61-d7b2-46e1-be72-84561c37a348",
					"diagramNodeId": "f8a8031b-a020-4346-b63a-6e264293a32f",
					"simStepLabel": "Resolve and Package Handler Code",
					"simStepDescription": "Using the 'src/handler.generateRandomNumber' path from the configuration, the Serverless Framework locates the `generateRandomNumber` export within the `src/handler.js` file. It then packages this file and its dependencies into a deployment artifact (a .zip file).",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/handler.js",
						"startLine": "1",
						"endLine": "1",
						"relevantVariables": [
							"generateRandomNumber"
						]
					},
					"inputDataExample": "{\"handlerPath\": \"src/handler.generateRandomNumber\"}",
					"outputDataExample": "{\"deploymentPackagePath\": \".serverless/basic-serverless-lambda.zip\"}"
				},
				{
					"simStepId": "ea0a12fa-4264-41c1-8873-cbd40cd95051",
					"diagramNodeId": "a8edb2e7-9788-47b3-b4ba-c22b90a404bc",
					"simStepLabel": "Prepare Deployment Artifacts",
					"simStepDescription": "The generated code package (.zip file) and a dynamically created AWS CloudFormation template are prepared for deployment. These artifacts contain all the necessary information to create the Lambda function on AWS.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "1",
						"endLine": "25",
						"relevantVariables": [
							"serverless deploy"
						]
					},
					"inputDataExample": "{\"deploymentPackage\": \".serverless/basic-serverless-lambda.zip\", \"cloudFormationTemplate\": \"cloudformation-template-update-stack.json\"}",
					"outputDataExample": "{\"deploymentPackage\": \".serverless/basic-serverless-lambda.zip\", \"cloudFormationTemplate\": \"cloudformation-template-update-stack.json\"}"
				},
				{
					"simStepId": "33bd3a53-e2c0-4201-9731-d23579c5c2f3",
					"diagramNodeId": "9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5",
					"simStepLabel": "Deploy to AWS via CloudFormation",
					"simStepDescription": "The `serverless deploy` command, often run in a CI/CD pipeline like GitHub Actions, uploads the deployment package to an S3 bucket. It then creates or updates an AWS CloudFormation stack, which provisions the 'hello' Lambda function according to the specifications in the template.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "1",
						"endLine": "25",
						"relevantVariables": [
							"serverless deploy"
						]
					},
					"inputDataExample": "{\"cliCommand\": \"serverless deploy --stage dev --region us-west-1\"}",
					"outputDataExample": "{\"status\": \"Deployment Successful\", \"service\": \"basic-serverless-lambda\", \"functionName\": \"basic-serverless-lambda-dev-hello\"}"
				}
			],
			"description": "<ul><li>The primary use case is to define and deploy a single, event-driven function on AWS Lambda</li><li>The <code>serverless</li><li>yml</code> file configures a function named 'hello' which is mapped to the <code>generateRandomNumber</code> method in <code>src/handler</li><li>js</code></li><li>This demonstrates the core value of serverless architecture: running code without provisioning or managing servers</li></ul>",
			"simulationNodesAndEdges": {
				"e44c8697-6df5-468f-8412-f8d05e26bbb9": {
					"simStepIds": [
						"9ebf4db5-aabd-4d3e-b5e3-f72873bf00c0"
					]
				},
				"f8a8031b-a020-4346-b63a-6e264293a32f": {
					"simStepIds": [
						"66396f61-d7b2-46e1-be72-84561c37a348"
					]
				},
				"9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5": {
					"simStepIds": [
						"33bd3a53-e2c0-4201-9731-d23579c5c2f3"
					]
				},
				"55e29172-4e22-4b98-9e31-262ff35125fd": {
					"simStepIds": [
						"1d66d1da-06e4-4e9f-b9ef-be7c769c2187"
					]
				},
				"a8edb2e7-9788-47b3-b4ba-c22b90a404bc": {
					"simStepIds": [
						"ea0a12fa-4264-41c1-8873-cbd40cd95051"
					]
				}
			},
			"isAIGenerated": true,
			"keywords": "handler, functions, serverless.yml",
			"generationPrompt": "Deploy a Serverless API Endpoint on AWS Lambda",
			"generationKeywords": "handler, functions, serverless.yml"

		"serverless.yml-simstep-6cad9a92-5b9e-497b-b2fd-0e41a95663e4": {
			"path": "serverless.yml-simstep-6cad9a92-5b9e-497b-b2fd-0e41a95663e4",
			"fileName": "serverless.yml",
			"wiki": "The Infrastructure as Code (IaC) process begins with the `serverless.yml` file. The top-level `service` key defines the application's name, which the Serverless Framework uses to group all related cloud resources into a single stack.",
			"cellName": "IaC Flow: Service Definition - serverless.yml:L1-2",
			"cellId": "c52e184a-e869-4e4d-b1ad-2c5316e64aeb",
			"visible": true,
			"startLine": 1,
			"endLine": 2,
			"parentCellId": "877df854-419a-4781-81d8-ca4ab321d7ee",
			"parentPath": "serverless.yml",
			"simSteps": [
				{
					"simulationKey": "Manage Cloud Infrastructure as Code (IaC)",
					"simStepId": "6cad9a92-5b9e-497b-b2fd-0e41a95663e4"
				}
			]
		},
		"03418c8b-1ff2-4962-9aa0-b1c81b16d08a": {
			"path": "03418c8b-1ff2-4962-9aa0-b1c81b16d08a",
			"fileName": "03418c8b-1ff2-4962-9aa0-b1c81b16d08a",
			"cellName": "IaC Flow: Provider Configuration - serverless.yml:L4-7",
			"cellId": "03418c8b-1ff2-4962-9aa0-b1c81b16d08a",
			"visible": true,
			"parentCellId": "877df854-419a-4781-81d8-ca4ab321d7ee"
		},
		"serverless.yml-simstep-66cc21ed-40a2-4381-ba4e-e92178c1fe47": {
			"path": "serverless.yml-simstep-66cc21ed-40a2-4381-ba4e-e92178c1fe47",
			"fileName": "serverless.yml",
			"wiki": "The `provider` block specifies the cloud platform and default settings. It configures the service to use Amazon Web Services (AWS) with a Node.js 18.x runtime, deploying to the `dev` stage in the `us-west-1` region. These settings apply to all functions within the service unless overridden.",
			"cellName": "IaC Flow: Provider Configuration - serverless.yml:L4-7",
			"cellId": "03418c8b-1ff2-4962-9aa0-b1c81b16d08a",
			"visible": true,
			"startLine": 4,
			"endLine": 7,
			"parentCellId": "877df854-419a-4781-81d8-ca4ab321d7ee",
			"parentPath": "serverless.yml",
			"simSteps": [
				{
					"simulationKey": "Manage Cloud Infrastructure as Code (IaC)",
					"simStepId": "66cc21ed-40a2-4381-ba4e-e92178c1fe47"
				}

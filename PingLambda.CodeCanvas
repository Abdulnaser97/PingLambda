		"Automate Cloud Deployments with a CI/CD Pipeline": {
			"name": "Automate Cloud Deployments with a CI/CD Pipeline",
			"simSteps": [
				{
					"simStepId": "bc2b3a76-f2a7-4680-95c1-1ea05c4a4d04",
					"diagramNodeId": "7c2c2af8-f4f3-49e1-84b3-4c2388f18d5a",
					"simStepLabel": "CI/CD Flow: Workflow Triggered by Push to Main Branch",
					"simStepDescription": "The CI/CD pipeline is automatically initiated when a `git push` event occurs on the `main` branch of the GitHub repository. This is the starting point of the automated deployment process.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "4",
						"endLine": "6",
						"relevantVariables": [
							"on",
							"push",
							"branches"
						]
					},
					"inputDataExample": "{\n  \"ref\": \"refs/heads/main\",\n  \"before\": \"a8e47087e5b22b6d68b753a32f413009919d3652\",\n  \"after\": \"b9c6f24d8b9d3b7e6f8a0d2c3e4f5a6b7c8d9e0f\",\n  \"repository\": {\n    \"full_name\": \"PerfAI-Inc/PingLambda\"\n  },\n  \"pusher\": {\n    \"name\": \"github_user\",\n    \"email\": \"user@example.com\"\n  }\n}",
					"outputDataExample": "{\n  \"trigger_event\": \"push\",\n  \"branch\": \"main\",\n  \"job_to_run\": \"deploy\"\n}"
				},
				{
					"simStepId": "1c32a872-5f46-4230-8302-28c42104482c",
					"diagramNodeId": "3b3935f8-d71f-4ccd-91c2-237a6bb5df37",
					"simStepLabel": "CI/CD Flow: Event Data to Deploy Job",
					"simStepDescription": "The push event data is passed to the 'deploy' job, which is defined in the workflow. This signals GitHub Actions to provision a runner and start the job execution.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "8",
						"endLine": "9",
						"relevantVariables": [
							"jobs",
							"deploy"
						]
					},
					"inputDataExample": "{\n  \"trigger_event\": \"push\",\n  \"branch\": \"main\",\n  \"job_to_run\": \"deploy\"\n}",
					"outputDataExample": "{\n  \"trigger_event\": \"push\",\n  \"branch\": \"main\",\n  \"job_to_run\": \"deploy\"\n}"
				},
				{
					"simStepId": "800e3d2f-a911-470f-b763-87b657cfe45f",
					"diagramNodeId": "7ab273b9-870d-4108-8f62-b9b72ce62fff",
					"simStepLabel": "CI/CD Flow: Setup Node.js Environment",
					"simStepDescription": "The 'deploy' job begins execution on an Ubuntu runner. The first step within the job is to use the `actions/setup-node` action to install and configure the specified Node.js version (18.x) required for the deployment.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "19",
						"endLine": "22",
						"relevantVariables": [
							"uses: actions/setup-node@v1",
							"matrix.node-version"
						]
					},
					"inputDataExample": "{\n  \"runner\": \"ubuntu-latest\",\n  \"node-version-matrix\": \"18.x\"\n}",
					"outputDataExample": "{\n  \"node_version_installed\": \"18.x\",\n  \"environment_ready\": true\n}"
				},
				{
					"simStepId": "7af03874-6033-4f46-91eb-22d13a79bc3a",
					"diagramNodeId": "8262121a-6964-4479-ab5f-fffad831d811",
					"simStepLabel": "CI/CD Flow: Pass AWS Credentials to Serverless Action",
					"simStepDescription": "With the environment set up, the workflow passes the necessary AWS credentials, stored as GitHub secrets, as environment variables to the next step, the Serverless Framework GitHub Action.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "27",
						"endLine": "30",
						"relevantVariables": [
							"env",
							"AWS_ACCESS_KEY_ID",
							"secrets.AWS_ACCESS_KEY_ID"
						]
					},
					"inputDataExample": "{\n  \"secrets_context_available\": true\n}",
					"outputDataExample": "{\n  \"AWS_ACCESS_KEY_ID\": \"[redacted]\",\n  \"AWS_SECRET_ACCESS_KEY\": \"[redacted]\"\n}"
				},
				{
					"simStepId": "86dab1f7-5101-466e-b243-51c8f9d23505",
					"diagramNodeId": "74573102-d310-4288-b4e7-47484433a39a",
					"simStepLabel": "CI/CD Flow: Execute Serverless Deploy",
					"simStepDescription": "The `serverless/github-action` is executed with the `deploy` argument. This action uses the provided AWS credentials to authenticate with AWS, then packages the Lambda function defined in `serverless.yml` and `src/handler.js`, and deploys it to the AWS account.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": ".github/workflows/main.yml",
						"startLine": "24",
						"endLine": "30",
						"relevantVariables": [
							"uses: serverless/github-action@master",
							"args: deploy",
							"env"
						]
					},
					"inputDataExample": "{\n  \"action_name\": \"serverless/github-action@master\",\n  \"args\": \"deploy\",\n  \"env\": {\n    \"AWS_ACCESS_KEY_ID\": \"[redacted]\",\n    \"AWS_SECRET_ACCESS_KEY\": \"[redacted]\"\n  }\n}",
					"outputDataExample": "{\n  \"status\": \"Deployment Successful\",\n  \"service\": \"ping-lambda\",\n  \"stage\": \"dev\",\n  \"region\": \"us-east-1\",\n  \"deployed_functions\": [\n    \"ping\"\n  ]\n}"
				}
			],
			"description": "<ul><li>The repository is configured with a GitHub Actions workflow (<code></li><li>github/workflows/main</li><li>yml</code>)</li><li>This workflow automatically triggers on every push to the 'main' branch</li><li>It uses the Serverless Framework's GitHub Action to deploy the service to AWS, showcasing a complete CI/CD pipeline for serverless applications</li></ul>",
			"simulationNodesAndEdges": {
				"7c2c2af8-f4f3-49e1-84b3-4c2388f18d5a": {
					"simStepIds": [

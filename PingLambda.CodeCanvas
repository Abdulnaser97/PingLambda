		"serverless.yml-simstep-9ebf4db5-aabd-4d3e-b5e3-f72873bf00c0": {
			"path": "serverless.yml-simstep-9ebf4db5-aabd-4d3e-b5e3-f72873bf00c0",
			"fileName": "serverless.yml",
			"wiki": "The process starts with the Serverless Framework parsing the `serverless.yml` file. This file defines the service name ('basic-serverless-lambda'), the cloud provider (AWS), and the default configuration like runtime, stage, and region for all functions in the service.",
			"cellName": "Define Service Configuration - serverless.yml:L1-8",
			"cellId": "e44c8697-6df5-468f-8412-f8d05e26bbb9",
			"visible": true,

		"9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5": {
			"path": "9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5",
			"fileName": "9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5",
			"cellName": "Deploy to AWS via CloudFormation - main.yml:L1-25",
			"cellId": "9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5",
			"visible": true,
			"parentCellId": "b56b3080-88ac-4fc9-84f4-98fbd89acf34"
		},
		".github/workflows/main.yml-simstep-33bd3a53-e2c0-4201-9731-d23579c5c2f3": {
			"path": ".github/workflows/main.yml-simstep-33bd3a53-e2c0-4201-9731-d23579c5c2f3",
			"fileName": "main.yml",
			"wiki": "The `serverless deploy` command, often run in a CI/CD pipeline like GitHub Actions, uploads the deployment package to an S3 bucket. It then creates or updates an AWS CloudFormation stack, which provisions the 'hello' Lambda function according to the specifications in the template.",
			"cellName": "Deploy to AWS via CloudFormation - main.yml:L1-25",
			"cellId": "9fb7581a-9e16-4f3a-9d5a-27379c9ee2f5",
			"visible": true,

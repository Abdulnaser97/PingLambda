		"Manage Cloud Infrastructure as Code (IaC)": {
			"name": "Manage Cloud Infrastructure as Code (IaC)",
			"simSteps": [
				{
					"simStepId": "6cad9a92-5b9e-497b-b2fd-0e41a95663e4",
					"diagramNodeId": "c52e184a-e869-4e4d-b1ad-2c5316e64aeb",
					"simStepLabel": "IaC Flow: Service Definition",
					"simStepDescription": "The Infrastructure as Code (IaC) process begins with the `serverless.yml` file. The top-level `service` key defines the application's name, which the Serverless Framework uses to group all related cloud resources into a single stack.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "1",
						"endLine": "2",
						"relevantVariables": [
							"service"
						]
					},
					"inputDataExample": "{\n  \"action\": \"deploy\",\n  \"configFile\": \"serverless.yml\"\n}",
					"outputDataExample": "{\n  \"serviceName\": \"basic-serverless-lambda\"\n}"
				},
				{
					"simStepId": "e3665015-1825-4188-bae8-4655579b0ec0",
					"diagramNodeId": "d7541a70-1c97-4b76-acd3-749c3aec5b0a",
					"simStepLabel": "IaC Flow: Service to Provider Configuration",
					"simStepDescription": "The service definition context is passed to the `provider` configuration block to define global settings for the service.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "3",
						"endLine": "3",
						"relevantVariables": [
							"provider"
						]
					},
					"inputDataExample": "{\n  \"serviceName\": \"basic-serverless-lambda\"\n}",
					"outputDataExample": "{\n  \"serviceName\": \"basic-serverless-lambda\"\n}"
				},
				{
					"simStepId": "66cc21ed-40a2-4381-ba4e-e92178c1fe47",
					"diagramNodeId": "03418c8b-1ff2-4962-9aa0-b1c81b16d08a",
					"simStepLabel": "IaC Flow: Provider Configuration",
					"simStepDescription": "The `provider` block specifies the cloud platform and default settings. It configures the service to use Amazon Web Services (AWS) with a Node.js 18.x runtime, deploying to the `dev` stage in the `us-west-1` region. These settings apply to all functions within the service unless overridden.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "4",
						"endLine": "7",
						"relevantVariables": [
							"name",
							"runtime",
							"stage",
							"region"
						]
					},
					"inputDataExample": "{\n  \"serviceName\": \"basic-serverless-lambda\"\n}",
					"outputDataExample": "{\n  \"providerConfig\": {\n    \"name\": \"aws\",\n    \"runtime\": \"nodejs18.x\",\n    \"stage\": \"dev\",\n    \"region\": \"us-west-1\"\n  }\n}"
				},
				{
					"simStepId": "245f988a-5eba-4cfa-8074-a2a7a7e28dc3",
					"diagramNodeId": "82862d97-35f6-48dd-a2c7-95540f7f8b93",
					"simStepLabel": "IaC Flow: Provider to Function Configuration",
					"simStepDescription": "The global provider configuration is passed down to the `functions` block, serving as the default environment for all defined functions.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "9",
						"endLine": "9",
						"relevantVariables": [
							"functions"
						]
					},
					"inputDataExample": "{\n  \"providerConfig\": {\n    \"name\": \"aws\",\n    \"runtime\": \"nodejs18.x\",\n    \"stage\": \"dev\",\n    \"region\": \"us-west-1\"\n  }\n}",
					"outputDataExample": "{\n  \"providerConfig\": {\n    \"name\": \"aws\",\n    \"runtime\": \"nodejs18.x\",\n    \"stage\": \"dev\",\n    \"region\": \"us-west-1\"\n  }\n}"
				},
				{
					"simStepId": "1e9bf09e-c953-4050-999d-6942e061e873",
					"diagramNodeId": "71bbfc48-660c-4560-bfe0-dbdc38291064",
					"simStepLabel": "IaC Flow: Function Definition",
					"simStepDescription": "A specific cloud function, named `hello`, is defined. This block specifies the function's properties, including the `handler` which points to the code to be executed (`src/handler.generateRandomNumber`), a `timeout` of 60 seconds, and a `memorySize` of 128 MB. This declarative configuration is used to provision an AWS Lambda resource.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "10",
						"endLine": "13",
						"relevantVariables": [
							"hello",
							"handler",
							"timeout",
							"memorySize"
						]
					},
					"inputDataExample": "{\n  \"providerConfig\": {\n    \"name\": \"aws\",\n    \"runtime\": \"nodejs18.x\"\n  }\n}",
					"outputDataExample": "{\n  \"functionName\": \"hello\",\n  \"functionConfig\": {\n    \"handler\": \"src/handler.generateRandomNumber\",\n    \"timeout\": 60,\n    \"memorySize\": 128\n  }\n}"
				},
				{
					"simStepId": "e7c093c5-c9e4-47d2-8942-616b888ba71d",
					"diagramNodeId": "406f34bd-2c36-463c-bc10-7839ad959e0e",
					"simStepLabel": "IaC Flow: Linking Configuration to Code",
					"simStepDescription": "The `handler` property value (`src/handler.generateRandomNumber`) creates a direct link between the cloud resource configuration and the application code. It instructs the Serverless Framework and AWS where to find the specific exported function to execute.",
					"isEdge": 1,
					"sourceCodeMapping": {
						"filePath": "serverless.yml",
						"startLine": "11",
						"endLine": "11",
						"relevantVariables": [
							"handler"
						]
					},
					"inputDataExample": "{\n  \"handlerPath\": \"src/handler.generateRandomNumber\"\n}",
					"outputDataExample": "{\n  \"handlerPath\": \"src/handler.generateRandomNumber\"\n}"
				},
				{
					"simStepId": "2c68f18b-5ad8-4527-882d-9392bd315bb8",
					"diagramNodeId": "95763276-55b7-4fa3-957b-573450aa569d",
					"simStepLabel": "IaC Flow: Target Application Code",
					"simStepDescription": "The `handler` path resolves to the `generateRandomNumber` function exported from the `src/handler.js` file. This file contains the application logic that will be packaged and deployed to AWS Lambda, ready to be executed when the `hello` function is invoked.",
					"isEdge": 0,
					"sourceCodeMapping": {
						"filePath": "src/handler.js",
						"startLine": "1",
						"endLine": "1",
						"relevantVariables": [
